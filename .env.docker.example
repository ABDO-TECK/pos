# ════════════════════════════════════════════════════════════════
# POS Docker — Environment Variables
# ════════════════════════════════════════════════════════════════
# كيفية الاستخدام:
#   1. انسخ هذا الملف:  copy .env.docker.example .env
#   2. غيّر كلمة المرور أدناه
#   3. شغّل: docker-compose up -d --build
# ════════════════════════════════════════════════════════════════

# كلمة مرور قاعدة البيانات (غيّرها لقيمة آمنة!)
DB_PASS=change_me_to_a_strong_password

# تفعيل Persistent Connections (مُوصى به مع Docker/Apache)
DB_PERSISTENT=true

# فرض HTTPS (true فقط إذا لديك شهادة SSL)
FORCE_HTTPS=false
SECURE_COOKIES=false

# رابط الواجهة الأمامية
FRONTEND_URL=http://localhost:8000
