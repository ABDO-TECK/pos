# ════════════════════════════════════════════════════════════════
# POS Docker — Environment Variables
# ════════════════════════════════════════════════════════════════
# كيفية الاستخدام:
#   1. انسخ هذا الملف:  copy .env.docker.example .env
#   2. غيّر كلمة المرور أدناه وأي إعدادات أخرى
#   3. شغّل: docker-compose up -d --build
# ════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────
# كلمة مرور قاعدة البيانات (غيّرها لقيمة آمنة!)
DB_PASS=change_me_to_a_strong_password

# ── Security & HTTPS ───────────────────────────────────────────
# فرض HTTPS (true فقط إذا لديك شهادة SSL لبيئة الإنتاج)
FORCE_HTTPS=false
SECURE_COOKIES=false

# ── Frontend ───────────────────────────────────────────────────
# رابط الواجهة الأمامية
FRONTEND_URL=http://localhost:8000

# ── Redis (اختياري) ────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ── App Settings ───────────────────────────────────────────────
TOKEN_LIFETIME=604800
LOW_STOCK_THRESHOLD=5
TAX_RATE=0.15
QZ_PRIVATE_KEY_PATH=
