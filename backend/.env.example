# ════════════════════════════════════════════════════════════════
# POS System — Environment Configuration (Example)
# ════════════════════════════════════════════════════════════════
# كيفية الاستخدام:
#   1. انسخ هذا الملف:  copy .env.example .env
#   2. عدّل القيم أدناه حسب بيئتك
#   3. لا تُضف .env إلى Git (مُدرج في .gitignore)
# ════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=pos_db
DB_USER=root
DB_PASS=your_secure_password_here
DB_CHARSET=utf8mb4

# تفعيل Persistent Connections (مُوصى به في الإنتاج مع Apache/php-fpm)
# اتركه false في التطوير المحلي أو مع Electron
DB_PERSISTENT=false

# ── Application ────────────────────────────────────────────────
# APP_ENV: development | production
APP_ENV=production
# ⚠️ في الإنتاج: APP_DEBUG يُجبر على false تلقائياً حتى لو ضُبط true
APP_DEBUG=false

# ── Security & HTTPS ───────────────────────────────────────────
# ┌─────────────────────────────────────────────────────────────┐
# │ ⚠️  إعدادات الأمان — مهم جداً ضبطها حسب بيئة التشغيل:     │
# │                                                             │
# │ 🔒 إنتاج (خادم حقيقي مع شهادة SSL):                       │
# │     FORCE_HTTPS=true                                        │
# │     SECURE_COOKIES=true                                     │
# │                                                             │
# │ 🖥️  تطوير محلي (XAMPP / Electron بدون SSL):                │
# │     FORCE_HTTPS=false                                       │
# │     SECURE_COOKIES=false                                    │
# │                                                             │
# │ 📱 شبكة محلية مع mkcert (HTTPS عبر LAN):                   │
# │     FORCE_HTTPS=false (لأن بعض الأجهزة قد لا تدعم الشهادة) │
# │     SECURE_COOKIES=false                                    │
# └─────────────────────────────────────────────────────────────┘
#
# FORCE_HTTPS:    يُعيد توجيه HTTP → HTTPS تلقائياً (301 redirect)
#                 + يُضيف HSTS header لمنع downgrade attacks
# SECURE_COOKIES: يُرسل cookies مع Secure flag + SameSite=Strict
#                 (يمنع إرسال cookies عبر HTTP غير مشفر)
# ⚠️ في الإنتاج: يجب تغييرها إلى true (سيظهر تحذير في اللوج إذا بقيت false)
FORCE_HTTPS=true
SECURE_COOKIES=true

# ── Redis (اختياري — للتخزين المؤقت في الإنتاج) ────────────────
# اتركه فارغاً لاستخدام التخزين على الملفات (الافتراضي)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth Token ─────────────────────────────────────────────────
# مدة صلاحية التوكن بالثواني (604800 = أسبوع)
TOKEN_LIFETIME=604800

# ── Inventory ──────────────────────────────────────────────────
# حد المخزون المنخفض الافتراضي (يمكن تعديله من إعدادات المتجر)
LOW_STOCK_THRESHOLD=5

# ── Tax ────────────────────────────────────────────────────────
TAX_RATE=0.15

# ── Frontend ───────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ── QZ Tray (Thermal Printing) ─────────────────────────────────
# المسار الكامل لملف المفتاح الخاص (private-key.pem) لتوقيع طباعة QZ Tray.
#
# ⚠️  قواعد أمان مهمة:
#   - يجب أن يكون الملف خارج مجلد المشروع (خارج htdocs)
#   - لا تُوقع الملف في Git أبداً
#   - تأكد من أن صلاحيات الملف 600 (مقروء من PHP فقط)
#
# مثال على مسارات آمنة:
#   Windows:  QZ_PRIVATE_KEY_PATH="C:/private/pos-keys/private-key.pem"
#   Linux:    QZ_PRIVATE_KEY_PATH="/etc/pos/private-key.pem"
#
# اتركه فارغاً للعمل في وضع الطباعة بدون توقيع (وضع التطوير):
#   QZ_PRIVATE_KEY_PATH=""
QZ_PRIVATE_KEY_PATH="C:/private/private-key.pem"
